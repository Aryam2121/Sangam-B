# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/Sangam

# JWT
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=10d

CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://sangam-frontend-two.vercel.app
PORT=3002

# Firebase Admin — download service account JSON from Firebase Console
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gemini assistant (optional)
GEMINI_API_KEY=your_gemini_api_key

# Seed script (required when running npm run seed)
SEED_DEFAULT_PASSWORD=ChangeMeInProduction123!

NODE_ENV=development
